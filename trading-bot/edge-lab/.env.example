# Copy to .env (same folder) and fill in what you need. .env is gitignored and never leaves your computer.

# Required before opening Edge Lab from another device (12+ characters).
# EDGE_LAB_PASSWORD=choose-a-long-password

# Only for API billing (Settings → Billing → Claude API key). Leave empty to use your Claude subscription.
# EDGE_LAB_API_KEY=sk-ant-...

# Your Tailscale machine name, e.g. mypc.tail1234.ts.net (see README → Access from your phone).
# ALLOWED_HOSTS=

# PORT=3007
# CLAUDE_BIN=C:\Users\User\AppData\Roaming\npm\claude.cmd
# PYTHON=python
