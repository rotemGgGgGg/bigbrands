//@version=6
strategy("10 Liquidity Sweep Reversal | NQ/MNQ", overlay=true, pyramiding=0, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=2)
qty = input.int(1, "Contracts", minval=1)
lookback = input.int(20, "Liquidity Lookback", minval=5)
emaLen = input.int(100, "Trend EMA")
atrLen = input.int(14, "ATR Length")
slATR = input.float(1.6, "Stop ATR", minval=0.1)
tpATR = input.float(0.9, "Target ATR", minval=0.1)
priorHigh = ta.highest(high, lookback)[1]
priorLow = ta.lowest(low, lookback)[1]
ema = ta.ema(close, emaLen)
atr = ta.atr(atrLen)
longSignal = low < priorLow and close > priorLow and close > ema
shortSignal = high > priorHigh and close < priorHigh and close < ema
if strategy.position_size == 0
    if longSignal
        strategy.entry("L", strategy.long, qty=qty)
    if shortSignal
        strategy.entry("S", strategy.short, qty=qty)
if strategy.position_size > 0
    strategy.exit("LX", "L", stop=strategy.position_avg_price - atr * slATR, limit=strategy.position_avg_price + atr * tpATR)
if strategy.position_size < 0
    strategy.exit("SX", "S", stop=strategy.position_avg_price + atr * slATR, limit=strategy.position_avg_price - atr * tpATR)
plot(priorHigh, "Prior Liquidity High", color=color.red, style=plot.style_linebr)
plot(priorLow, "Prior Liquidity Low", color=color.green, style=plot.style_linebr)
plot(ema, "Trend EMA", color=color.orange)
