//@version=6
strategy("RSI Pivot Divergence Approximation | NQ/MNQ", overlay=true, pyramiding=0, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=2)
qty = input.int(1, "Contracts", minval=1)
atrLen = input.int(14, "ATR Length")
slATR = input.float(1.5, "Stop ATR", minval=0.1)
tpATR = input.float(1.0, "Target ATR", minval=0.1)
atr = ta.atr(atrLen)
ema = ta.ema(close, input.int(100, "Trend EMA"))
longSignal = false
shortSignal = false
len = input.int(5, "Pivot Length")
r = ta.rsi(close, 14)
plPrice = ta.pivotlow(low, len, len)
phPrice = ta.pivothigh(high, len, len)
plRsi = ta.pivotlow(r, len, len)
phRsi = ta.pivothigh(r, len, len)
prevLow = ta.valuewhen(not na(plPrice), plPrice, 1)
prevLowRsi = ta.valuewhen(not na(plRsi), plRsi, 1)
prevHigh = ta.valuewhen(not na(phPrice), phPrice, 1)
prevHighRsi = ta.valuewhen(not na(phRsi), phRsi, 1)
bullDiv = not na(plPrice) and not na(prevLow) and plPrice < prevLow and plRsi > prevLowRsi
bearDiv = not na(phPrice) and not na(prevHigh) and phPrice > prevHigh and phRsi < prevHighRsi
longSignal := bullDiv and close > ema
shortSignal := bearDiv and close < ema

if strategy.position_size == 0
    if longSignal
        strategy.entry("L", strategy.long, qty=qty)
    else if shortSignal
        strategy.entry("S", strategy.short, qty=qty)
if strategy.position_size > 0
    strategy.exit("LX", "L", stop=strategy.position_avg_price - atr * slATR, limit=strategy.position_avg_price + atr * tpATR)
if strategy.position_size < 0
    strategy.exit("SX", "S", stop=strategy.position_avg_price + atr * slATR, limit=strategy.position_avg_price - atr * tpATR)
plot(ema, "Trend EMA", color=color.orange)
