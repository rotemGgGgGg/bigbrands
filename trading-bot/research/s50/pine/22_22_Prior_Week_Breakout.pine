//@version=6
strategy("Prior Week High/Low Breakout | NQ/MNQ", overlay=true, pyramiding=0, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=2)
qty = input.int(1, "Contracts", minval=1)
atrLen = input.int(14, "ATR Length")
slATR = input.float(1.5, "Stop ATR", minval=0.1)
tpATR = input.float(1.0, "Target ATR", minval=0.1)
atr = ta.atr(atrLen)
ema = ta.ema(close, input.int(100, "Trend EMA"))
longSignal = false
shortSignal = false
pwHigh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
pwLow = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_on)
longSignal := ta.crossover(close, pwHigh)
shortSignal := ta.crossunder(close, pwLow)
plot(pwHigh, "Prior Week High", color=color.green)
plot(pwLow, "Prior Week Low", color=color.red)

if strategy.position_size == 0
    if longSignal
        strategy.entry("L", strategy.long, qty=qty)
    else if shortSignal
        strategy.entry("S", strategy.short, qty=qty)
if strategy.position_size > 0
    strategy.exit("LX", "L", stop=strategy.position_avg_price - atr * slATR, limit=strategy.position_avg_price + atr * tpATR)
if strategy.position_size < 0
    strategy.exit("SX", "S", stop=strategy.position_avg_price + atr * slATR, limit=strategy.position_avg_price - atr * tpATR)
plot(ema, "Trend EMA", color=color.orange)
