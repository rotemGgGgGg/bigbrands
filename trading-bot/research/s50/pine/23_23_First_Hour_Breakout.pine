//@version=6
strategy("First Hour Range Breakout | NQ/MNQ", overlay=true, pyramiding=0, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=2)
qty = input.int(1, "Contracts", minval=1)
atrLen = input.int(14, "ATR Length")
slATR = input.float(1.5, "Stop ATR", minval=0.1)
tpATR = input.float(1.0, "Target ATR", minval=0.1)
atr = ta.atr(atrLen)
ema = ta.ema(close, input.int(100, "Trend EMA"))
longSignal = false
shortSignal = false
sess = input.session("0930-1030", "Range Session (New York)")
tradeSess = input.session("1030-1200", "Trade Session (New York)")
inRange = not na(time(timeframe.period, sess, "America/New_York"))
inTrade = not na(time(timeframe.period, tradeSess, "America/New_York"))
newDay = ta.change(time("D")) != 0
var float rh = na
var float rl = na
if newDay
    rh := na
    rl := na
if inRange
    rh := na(rh) ? high : math.max(rh, high)
    rl := na(rl) ? low : math.min(rl, low)
longSignal := inTrade and not na(rh) and ta.crossover(close, rh)
shortSignal := inTrade and not na(rl) and ta.crossunder(close, rl)
plot(rh, "Range High", color=color.green)
plot(rl, "Range Low", color=color.red)

if strategy.position_size == 0
    if longSignal
        strategy.entry("L", strategy.long, qty=qty)
    else if shortSignal
        strategy.entry("S", strategy.short, qty=qty)
if strategy.position_size > 0
    strategy.exit("LX", "L", stop=strategy.position_avg_price - atr * slATR, limit=strategy.position_avg_price + atr * tpATR)
if strategy.position_size < 0
    strategy.exit("SX", "S", stop=strategy.position_avg_price + atr * slATR, limit=strategy.position_avg_price - atr * tpATR)
plot(ema, "Trend EMA", color=color.orange)
