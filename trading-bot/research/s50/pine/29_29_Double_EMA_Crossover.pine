//@version=6
strategy("Double EMA Crossover | NQ/MNQ", overlay=true, pyramiding=0, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=2)
qty = input.int(1, "Contracts", minval=1)
atrLen = input.int(14, "ATR Length")
slATR = input.float(1.5, "Stop ATR", minval=0.1)
tpATR = input.float(1.0, "Target ATR", minval=0.1)
atr = ta.atr(atrLen)
ema = ta.ema(close, input.int(100, "Trend EMA"))
longSignal = false
shortSignal = false
fastLen = input.int(12, "Fast DEMA")
slowLen = input.int(26, "Slow DEMA")
f = 2 * ta.ema(close, fastLen) - ta.ema(ta.ema(close, fastLen), fastLen)
s = 2 * ta.ema(close, slowLen) - ta.ema(ta.ema(close, slowLen), slowLen)
longSignal := ta.crossover(f, s)
shortSignal := ta.crossunder(f, s)
plot(f, "Fast DEMA", color=color.green)
plot(s, "Slow DEMA", color=color.orange)

if strategy.position_size == 0
    if longSignal
        strategy.entry("L", strategy.long, qty=qty)
    else if shortSignal
        strategy.entry("S", strategy.short, qty=qty)
if strategy.position_size > 0
    strategy.exit("LX", "L", stop=strategy.position_avg_price - atr * slATR, limit=strategy.position_avg_price + atr * tpATR)
if strategy.position_size < 0
    strategy.exit("SX", "S", stop=strategy.position_avg_price + atr * slATR, limit=strategy.position_avg_price - atr * tpATR)
plot(ema, "Trend EMA", color=color.orange)
