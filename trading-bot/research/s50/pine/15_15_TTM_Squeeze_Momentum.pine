//@version=6
strategy("Squeeze-Style Momentum Expansion | NQ/MNQ", overlay=true, pyramiding=0, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=2)
qty = input.int(1, "Contracts", minval=1)
atrLen = input.int(14, "ATR Length")
slATR = input.float(1.5, "Stop ATR", minval=0.1)
tpATR = input.float(1.0, "Target ATR", minval=0.1)
atr = ta.atr(atrLen)
ema = ta.ema(close, input.int(100, "Trend EMA"))
longSignal = false
shortSignal = false
bbLen = input.int(20, "BB Length")
bbMult = input.float(2.0, "BB Mult")
kcMult = input.float(1.5, "KC Mult")
basis = ta.sma(close, bbLen)
bbWidth = ta.stdev(close, bbLen) * bbMult
kcWidth = ta.atr(bbLen) * kcMult
squeezeOn = bbWidth < kcWidth
mom = ta.linreg(close - math.avg(math.avg(ta.highest(high, bbLen), ta.lowest(low, bbLen)), ta.sma(close, bbLen)), bbLen, 0)
longSignal := squeezeOn[1] and not squeezeOn and mom > 0
shortSignal := squeezeOn[1] and not squeezeOn and mom < 0

if strategy.position_size == 0
    if longSignal
        strategy.entry("L", strategy.long, qty=qty)
    else if shortSignal
        strategy.entry("S", strategy.short, qty=qty)
if strategy.position_size > 0
    strategy.exit("LX", "L", stop=strategy.position_avg_price - atr * slATR, limit=strategy.position_avg_price + atr * tpATR)
if strategy.position_size < 0
    strategy.exit("SX", "S", stop=strategy.position_avg_price + atr * slATR, limit=strategy.position_avg_price - atr * tpATR)
plot(ema, "Trend EMA", color=color.orange)
