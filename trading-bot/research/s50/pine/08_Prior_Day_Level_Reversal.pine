//@version=6
strategy("08 Prior Day Level Reversal | NQ/MNQ", overlay=true, pyramiding=0, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=2)
qty = input.int(1, "Contracts", minval=1)
atrLen = input.int(14, "ATR Length")
slATR = input.float(1.5, "Stop ATR", minval=0.1)
tpATR = input.float(0.9, "Target ATR", minval=0.1)
pdHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdLow = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
atr = ta.atr(atrLen)
longSignal = low < pdLow and close > pdLow
shortSignal = high > pdHigh and close < pdHigh
if strategy.position_size == 0
    if longSignal
        strategy.entry("L", strategy.long, qty=qty)
    if shortSignal
        strategy.entry("S", strategy.short, qty=qty)
if strategy.position_size > 0
    strategy.exit("LX", "L", stop=strategy.position_avg_price - atr * slATR, limit=strategy.position_avg_price + atr * tpATR)
if strategy.position_size < 0
    strategy.exit("SX", "S", stop=strategy.position_avg_price + atr * slATR, limit=strategy.position_avg_price - atr * tpATR)
plot(pdHigh, "Prior Day High", color=color.red, style=plot.style_linebr)
plot(pdLow, "Prior Day Low", color=color.green, style=plot.style_linebr)
