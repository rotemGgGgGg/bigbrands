//@version=6
strategy("07 RSI + MACD Trend Filter | NQ/MNQ", overlay=true, pyramiding=0, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=2)
qty = input.int(1, "Contracts", minval=1)
rsiLen = input.int(14, "RSI Length")
emaLen = input.int(100, "Trend EMA")
fastLen = input.int(12, "MACD Fast")
slowLen = input.int(26, "MACD Slow")
sigLen = input.int(9, "MACD Signal")
atrLen = input.int(14, "ATR Length")
slATR = input.float(1.7, "Stop ATR", minval=0.1)
tpATR = input.float(1.0, "Target ATR", minval=0.1)
r = ta.rsi(close, rsiLen)
[macd, signal, hist] = ta.macd(close, fastLen, slowLen, sigLen)
ema = ta.ema(close, emaLen)
atr = ta.atr(atrLen)
longSignal = ta.crossover(r, 50) and macd > signal and close > ema
shortSignal = ta.crossunder(r, 50) and macd < signal and close < ema
if strategy.position_size == 0
    if longSignal
        strategy.entry("L", strategy.long, qty=qty)
    if shortSignal
        strategy.entry("S", strategy.short, qty=qty)
if strategy.position_size > 0
    strategy.exit("LX", "L", stop=strategy.position_avg_price - atr * slATR, limit=strategy.position_avg_price + atr * tpATR)
if strategy.position_size < 0
    strategy.exit("SX", "S", stop=strategy.position_avg_price + atr * slATR, limit=strategy.position_avg_price - atr * tpATR)
plot(ema, "Trend EMA", color=color.orange)
