//@version=6
strategy("01 RSI Mean Reversion | NQ/MNQ", overlay=true, pyramiding=0, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=2)
qty = input.int(1, "Contracts", minval=1)
rsiLen = input.int(2, "RSI Length", minval=2)
oversold = input.int(10, "Oversold")
overbought = input.int(90, "Overbought")
trendLen = input.int(200, "Trend EMA")
atrLen = input.int(14, "ATR Length")
slATR = input.float(2.0, "Stop ATR", minval=0.1)
tpATR = input.float(1.0, "Target ATR", minval=0.1)
r = ta.rsi(close, rsiLen)
ema = ta.ema(close, trendLen)
atr = ta.atr(atrLen)
longSignal = ta.crossover(r, oversold) and close > ema
shortSignal = ta.crossunder(r, overbought) and close < ema
if strategy.position_size == 0
    if longSignal
        strategy.entry("L", strategy.long, qty=qty)
    if shortSignal
        strategy.entry("S", strategy.short, qty=qty)
if strategy.position_size > 0
    strategy.exit("LX", "L", stop=strategy.position_avg_price - atr * slATR, limit=strategy.position_avg_price + atr * tpATR)
if strategy.position_size < 0
    strategy.exit("SX", "S", stop=strategy.position_avg_price + atr * slATR, limit=strategy.position_avg_price - atr * tpATR)
plot(ema, "Trend EMA", color=color.orange)
