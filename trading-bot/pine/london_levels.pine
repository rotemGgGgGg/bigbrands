//@version=6
// London High / Low — the 00:00–06:00 New York range as black dotted lines, labelled, until 16:00.
indicator("London High / Low", overlay = true, max_lines_count = 50, max_labels_count = 50)

TZ = "America/New_York"
inLdn = not na(time(timeframe.period, "0000-0600", TZ))
afterLdn = not na(time(timeframe.period, "0600-1600", TZ))

var float hi = na
var float lo = na
var int   startBar = na
var line  hiLine = na
var line  loLine = na
var label hiLab = na
var label loLab = na

if inLdn and not inLdn[1]                    // London opens: start a new range
    hi := high
    lo := low
    startBar := bar_index
else if inLdn
    hi := math.max(hi, high)
    lo := math.min(lo, low)

if not inLdn and inLdn[1]                    // London closed: draw the two levels
    hiLine := line.new(startBar, hi, bar_index, hi, color = color.black, style = line.style_dotted, width = 1)
    loLine := line.new(startBar, lo, bar_index, lo, color = color.black, style = line.style_dotted, width = 1)
    hiLab := label.new(bar_index, hi, "London High", style = label.style_label_left, color = color.new(color.white, 100), textcolor = color.black, size = 10)
    loLab := label.new(bar_index, lo, "London Low", style = label.style_label_left, color = color.new(color.white, 100), textcolor = color.black, size = 10)
else if afterLdn and not na(hiLine)          // keep them running until 16:00
    line.set_x2(hiLine, bar_index)
    line.set_x2(loLine, bar_index)
    label.set_x(hiLab, bar_index)
    label.set_x(loLab, bar_index)
