//@version=6
// SP MODEL — MNQ, 5-minute. Implements SP_MODEL_BOT_SPEC.md with the trader's confirmed corrections.
// Section numbers in comments (§) refer to that spec. Decisions the spec does not make are marked [IMPL].
//
// v6 sweep timing: a sweep counts from 06:00. Only S1 needs its sweep inside 09:30–14:00.
//   S2 fib 1.0 = S1's anchor_0 where S1 failed (pre-open: the pullback extreme before the break).
//   S2 after a pre-open sweep: the reference is the post-sweep extreme at the first two-candle pullback;
//   S2 opens when price breaks it. After an in-window sweep, S2 opens when S1 fails. Entries only 09:30–14:00.
// v5 setup lifecycle (S1/S2/S3):
//   trigger → leg forms (a0 follows every new extreme, measured from the bar of a1)
//   → first bar that does not extend the leg: anchors freeze
//   → va_ratio re-checked every bar (S3: no check) until it enters the band: level locks, limit placed
//   → a new extreme at any point before the fill: unlock, re-anchor, start over
//   Ends only on: 1.0 break · chosen entry touched with no order working · 14:00 · (optional expiry)
//   Entry / stop / target are fixed from the lock on; nothing trails before or after the fill.
//
// margin 1%: the v6 default of 100% rejects every MNQ order (1 contract > $50K capital).
strategy("SP Model — MNQ 5m", shorttitle = "SP Model", overlay = true,
     initial_capital = 50000, pyramiding = 0,
     margin_long = 1, margin_short = 1,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0,
     process_orders_on_close = false, calc_on_every_tick = false,
     max_bars_back = 500, max_labels_count = 500, max_lines_count = 500)

const string TZ = "America/New_York"

// ───────────────────────────── Inputs ─────────────────────────────
grpScen = "Scenarios"
useS1 = input.bool(true, "S1 — sweep reverses", group = grpScen)
useS2 = input.bool(true, "S2 — sweep fails, continuation", group = grpScen)
useS3 = input.bool(true, "S3 — both London levels taken", group = grpScen)
s2Swing = input.bool(false, "S2 on intermediate swing highs / lows (unconfirmed)", group = grpScen,
     tooltip = "Pre-open sweeps: S2 also opens when price breaks a smaller swing formed on the way back, not only the post-sweep extreme.")

grpRisk = "Risk & sizing (§12, §13)"
riskUsd      = input.float(250.0, "Risk per trade ($)", minval = 1, group = grpRisk, tooltip = "25K: 125 · 50K: 250")
maxContracts = input.int(20, "Max contracts (prop firm limit)", minval = 1, group = grpRisk)
maxTrades    = input.int(1, "Max trades per day", minval = 1, group = grpRisk)
maxFails     = input.int(3, "Max failed setups per day", minval = 1, group = grpRisk)
useWeekly    = input.bool(true, "Weekly loss limit → days off", group = grpRisk)
weekLimitR   = input.float(3.0, "Weekly loss limit (R)", minval = 0.1, group = grpRisk)
daysOff      = input.int(2, "Trading days off after weekly limit", minval = 0, group = grpRisk)
useDdCut     = input.bool(true, "Cut risk in drawdown from equity high", group = grpRisk)
ddLimitR     = input.float(5.0, "Drawdown from high (R)", minval = 0.1, group = grpRisk)
ddRiskMult   = input.float(0.5, "Risk multiplier while in drawdown [IMPL]", minval = 0.1, maxval = 1.0, group = grpRisk)

grpSetup = "Setup"
vaLow        = input.float(0.412, "VA band low (0.5 entry from here)", step = 0.001, group = grpSetup)
vaMid        = input.float(0.5, "VA band mid (0.588 entry from here)", step = 0.001, group = grpSetup)
vaHigh       = input.float(0.588, "VA band high (no trade above)", step = 0.001, group = grpSetup)
expiryBars   = input.int(0, "Setup expiry (bars after trigger, 0 = off)", minval = 0, group = grpSetup)
legGrowMax   = input.float(0.0, "Leg-growth cap (× leg at trigger, 0 = off)", minval = 0.0, step = 0.1, group = grpSetup)
useLegFilter = input.bool(false, "Filter leg size at trigger", group = grpSetup)
legMinPts    = input.float(30, "Min leg at trigger (points)", group = grpSetup)
legMaxPts    = input.float(400, "Max leg at trigger (points)", group = grpSetup)

grpVp = "Volume profile (§8)"
vpRange = input.string("Fib leg", "Profile range", options = ["Fib leg", "London"], group = grpVp)
vpRows  = input.int(999, "Rows", minval = 10, maxval = 2000, group = grpVp)
vaPct   = input.float(70, "Value area %", minval = 10, maxval = 100, group = grpVp) / 100.0

grpNews = "News days (§2)"
useNews   = input.bool(true, "Skip news days", group = grpNews)
newsDates = input.text_area("2024-01-05,2024-01-11,2024-01-31,2024-02-02,2024-02-13,2024-03-08,2024-03-12,2024-03-20,2024-04-05,2024-04-10,2024-05-01,2024-05-03,2024-05-15,2024-06-07,2024-06-12,2024-07-05,2024-07-11,2024-07-31,2024-08-02,2024-08-14,2024-09-06,2024-09-11,2024-09-18,2024-10-04,2024-10-10,2024-11-01,2024-11-07,2024-11-13,2024-12-06,2024-12-11,2024-12-18", "CPI / FOMC / NFP dates (yyyy-MM-dd, comma separated)", group = grpNews)

grpVis = "Display"
showLdn    = input.bool(true, "London high / low", group = grpVis)
showLevels = input.bool(true, "Entry / stop / target", group = grpVis)
showLabels = input.bool(true, "Setup and trade labels", group = grpVis)
showTable  = input.bool(true, "Stats table", group = grpVis)
showFib    = input.bool(true, "Fib 1.0 / 0 anchors", group = grpVis)
checkInv   = input.bool(true, "Stop on invariant breach (debug)", group = grpVis,
     tooltip = "Halts the script with an error if an order ever disagrees with the model's own anchors.")

if timeframe.period != "5"
    runtime.error("SP Model runs on the 5-minute chart only (§1).")

// ───────────────────────────── Helpers ─────────────────────────────
// §7: 1.0 = where the move started, 0 = where it got to. dir: 1 long, -1 short.
fibPrice(float f1, float f0, int dir, float lvl) =>
    float rng = math.abs(f1 - f0)
    dir == -1 ? f0 + rng * lvl : f0 - rng * lvl

stopLevel(float lvl) =>
    lvl == 0.588 ? 0.816 : 0.702

targetLevel(float lvl) =>
    lvl == 0.588 ? 0.36 : 0.267

// §9: entry level from va_ratio. 0 = no trade. S3 always 0.5.
chooseLevel(int scen, float va) =>
    float lvl = 0.0
    if scen == 3
        lvl := 0.5
    else if not na(va)
        lvl := va > vaHigh ? 0.0 : va >= vaMid ? 0.588 : va >= vaLow ? 0.5 : 0.0
    lvl

// §8: fixed-range volume profile over bars [fromBar, toBar] and prices [lo, hi] → [VAH, VAL].
// Volume is spread evenly over the rows a bar touches (difference array, O(bars + rows)).
valueArea(int fromBar, int toBar, float lo, float hi) =>
    float vah = na
    float val = na
    if hi > lo and not na(fromBar) and not na(toBar) and toBar >= fromBar
        int rows = vpRows
        float rh = (hi - lo) / rows
        diff = array.new_float(rows + 1, 0.0)
        int oFrom = bar_index - toBar
        int oTo = math.min(bar_index - fromBar, 499)
        for i = oFrom to oTo
            float bh = high[i]
            float bl = low[i]
            float bv = nz(volume[i])
            if bh > lo and bl < hi
                int i0 = math.max(0, math.min(rows - 1, int(math.floor((bl - lo) / rh))))
                int i1 = math.max(0, math.min(rows - 1, int(math.floor((bh - lo) / rh))))
                float per = bv / (i1 - i0 + 1)
                diff.set(i0, diff.get(i0) + per)
                diff.set(i1 + 1, diff.get(i1 + 1) - per)
        bins = array.new_float(rows, 0.0)
        float run = 0.0
        float tot = 0.0
        int poc = 0
        float pocV = -1.0
        for k = 0 to rows - 1
            run += diff.get(k)
            bins.set(k, run)
            tot += run
            if run > pocV
                pocV := run
                poc := k
        if tot > 0
            float goal = tot * vaPct
            float acc = bins.get(poc)
            int up = poc
            int dn = poc
            while acc < goal and (up < rows - 1 or dn > 0)
                float vUp = up < rows - 1 ? bins.get(up + 1) : -1.0
                float vDn = dn > 0 ? bins.get(dn - 1) : -1.0
                if vUp >= vDn
                    up += 1
                    acc += vUp
                else
                    dn -= 1
                    acc += vDn
            vah := lo + (up + 1) * rh
            val := lo + dn * rh
    [vah, val]

scenName(int scen, int dir) =>
    "S" + str.tostring(scen) + (dir == 1 ? " LONG" : " SHORT")

fmt(float x, string f) =>
    na(x) ? "n/a" : str.tostring(x, f)

// ───────────────────────────── Time (§2) ─────────────────────────────
int  nyMin     = hour(time, TZ) * 60 + minute(time, TZ)    // bar OPEN time, NY
int  nyDate    = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
bool newDay    = nyDate != nyDate[1]
int  dow       = dayofweek(time, TZ)
bool isWeekday = dow >= dayofweek.monday and dow <= dayofweek.friday
bool isNews    = useNews and str.contains(newsDates, str.format_time(time, "yyyy-MM-dd", TZ))
bool inLondon  = nyMin < 360                                // 00:00–06:00
bool afterSix  = nyMin >= 360
bool inWin     = nyMin >= 570 and nyMin < 840               // 09:30–14:00
bool prevInWin = not newDay and nyMin[1] >= 570
bool canPlace  = nyMin + 5 < 840                            // an order placed now can only fill before 14:00
bool atFlatten = nyMin < 840 and nyMin + 5 >= 840           // the bar that closes at 14:00
int  weekKey   = year(time, TZ) * 100 + weekofyear(time, TZ)

// ───────────────────────────── State ─────────────────────────────
// London range and sweeps (§3, §4)
var float ldnH = na
var float ldnL = na
var int   ldnBars = 0
var int   dayStartBar = na
var int   ldnEndBar = na
var bool  hiSw = false
var bool  loSw = false
var int   hiSwBar = na
var int   loSwBar = na
var bool  hiSwInWin = false
var bool  loSwInWin = false
var float hiSinceHi = na       // a1 for a high-side short: highest high since the sweep
var int   hiSinceHiBar = na
var float loSinceHi = na       // a0 for that short: lowest low since the bar of hiSinceHi
var int   loSinceHiBar = na
var float loSinceLo = na       // a1 for a low-side long: lowest low since the sweep
var int   loSinceLoBar = na
var float hiSinceLo = na       // a0 for that long: highest high since the bar of loSinceLo
var int   hiSinceLoBar = na

// Active setup (§6, §14)
var int   setupScen = 0        // 0 = none
var int   setupDir = 0         // 1 long, -1 short
var int   setupSide = 0        // 1 = high side, -1 = low side (S1/S2)
var float a1 = na              // fib 1.0, fixed at trigger
var float a0 = na              // fib 0: follows the leg until the anchors freeze
var float liveA0 = na          // live extreme of the leg
var int   liveA0Bar = na       // bar of that extreme (S2 inherits it when S1 fails)
var bool  extending = false    // did this bar make a new extreme?
var bool  setupFrozen = false  // anchors frozen (first non-extending bar)
var bool  setupLocked = false  // va_ratio in band: level chosen, prices fixed
var float lockLevel = 0.0
var float lockVa = na
var float lockEntry = na
var int   lockBar = na
var float initRange = na
var int   trigBar = na
var int   legStart = na
var float ordLevel = 0.0       // level of the working limit, 0 = no order working
var int   ordQty = 0
var float ordPrice = na        // limit price of the working order (for the fill invariant)
var float a1AtArm = na         // invariant: a1 never moves after the trigger
var float a0AtFreeze = na      // invariant: a0 never moves while the anchors are frozen
var float ordRiskPts = na

// Position (§14 IN_POSITION)
var bool  inPos = false
var int   posScen = 0
var int   posDir = 0
var float posLevel = na
var float posA1 = na
var float posA0 = na
var float posRiskUsd = na
var float posVa = na
var float posLegTrig = na
var int   posBarsToFill = na
var int   posBarsToLock = na
var int   posEntryTime = na

// Daily counters and scenario flags (§11)
var int   failsToday = 0
var int   tradesToday = 0
var bool  doneDay = false
var bool  s1FailHi = false
var bool  s1FailLo = false
var bool  s2DeadHi = false
var bool  s2DeadLo = false
var bool  s3Dead = false
var int   lastDeathBar = -1

// S2 eligibility per side (hi = S2 LONG after the high was swept, lo = S2 SHORT after the low was swept)
var float s2RefHi = na         // post-sweep high at the first two-candle pullback (pre-open sweeps)
var int   s2RefHiBar = na
var float s2SwingHi = na       // latest swing high below the reference (swing variant)
var bool  s2EligHi = false
var int   s2EligHiBar = na
var float s2XHi = na           // running high since S2 opened = fib 0 for the S2 long
var int   s2XHiBar = na
var string s2WhyHi = ""
var float s2A1Hi = na          // S2 long fib 1.0: S1's anchor_0 when S1 failed, or the pre-open pullback low
var int   s2A1HiBar = na
var float s2PullHi = na        // pre-open: lowest low since the reference high (becomes s2A1Hi at the break)
var int   s2PullHiBar = na
var float s2RefLo = na
var int   s2RefLoBar = na
var float s2SwingLo = na
var bool  s2EligLo = false
var int   s2EligLoBar = na
var float s2XLo = na
var int   s2XLoBar = na
var string s2WhyLo = ""
var float s2A1Lo = na
var int   s2A1LoBar = na
var float s2PullLo = na        // pre-open: highest high since the reference low
var int   s2PullLoBar = na

// Risk limits and stats (§13, §16, §17)
var float cumR = 0.0
var float peakR = 0.0
var float maxDdR = 0.0
var float weekR = 0.0
var int   nTrades = 0
var int   nWins = 0
var int   n050 = 0
var int   w050 = 0
var float r050 = 0.0
var int   n0588 = 0
var int   w0588 = 0
var float r0588 = 0.0
var int   daysOffLeft = 0
var bool  weekLimitHit = false
var bool  blockedToday = false
var int   curWeek = na
var int   lastTradeCount = 0
var int   lastClosed = 0

float plotE = na
float plotS = na
float plotT = na

// ───────────────────────────── Daily reset at 00:00 NY (§2) ─────────────────────────────
if newDay
    if strategy.position_size != 0
        strategy.close_all(comment = "day reset", immediately = true)
    strategy.cancel("E")
    strategy.cancel("X")
    ldnH := na
    ldnL := na
    ldnBars := 0
    dayStartBar := bar_index
    ldnEndBar := na
    hiSw := false
    loSw := false
    hiSwBar := na
    loSwBar := na
    hiSwInWin := false
    loSwInWin := false
    setupScen := 0
    ordLevel := 0.0
    failsToday := 0
    tradesToday := 0
    doneDay := false
    s1FailHi := false
    s1FailLo := false
    s2DeadHi := false
    s2DeadLo := false
    s3Dead := false
    lastDeathBar := -1
    s2RefHi := na
    s2RefHiBar := na
    s2SwingHi := na
    s2EligHi := false
    s2EligHiBar := na
    s2XHi := na
    s2XHiBar := na
    s2A1Hi := na
    s2A1HiBar := na
    s2PullHi := na
    s2PullHiBar := na
    s2A1Lo := na
    s2A1LoBar := na
    s2PullLo := na
    s2PullLoBar := na
    s2RefLo := na
    s2RefLoBar := na
    s2SwingLo := na
    s2EligLo := false
    s2EligLoBar := na
    s2XLo := na
    s2XLoBar := na
    if weekKey != curWeek
        curWeek := weekKey
        weekR := 0.0
        weekLimitHit := false
    blockedToday := false
    if daysOffLeft > 0 and isWeekday
        blockedToday := true
        daysOffLeft -= 1

// ───────────────────────────── London range (§3) ─────────────────────────────
if inLondon
    ldnH := na(ldnH) ? high : math.max(ldnH, high)
    ldnL := na(ldnL) ? low : math.min(ldnL, low)
    ldnBars += 1
    ldnEndBar := bar_index
bool ldnValid = not na(ldnH) and ldnBars >= 60    // [IMPL] ≥60 of 72 bars, else "range never formed"

// ───────────────────────────── Sweeps and running extremes (§4) ─────────────────────────────
// a0 is tracked from the bar of a1, not from the sweep: when a1 makes a new extreme, a0 restarts there.
if afterSix and ldnValid
    if hiSw
        if high > hiSinceHi
            hiSinceHi := high
            hiSinceHiBar := bar_index
            loSinceHi := low
            loSinceHiBar := bar_index
        else if low < loSinceHi
            loSinceHi := low
            loSinceHiBar := bar_index
    if loSw
        if low < loSinceLo
            loSinceLo := low
            loSinceLoBar := bar_index
            hiSinceLo := high
            hiSinceLoBar := bar_index
        else if high > hiSinceLo
            hiSinceLo := high
            hiSinceLoBar := bar_index
    if not hiSw and high > ldnH
        hiSw := true
        hiSwBar := bar_index
        hiSwInWin := inWin
        hiSinceHi := high
        hiSinceHiBar := bar_index
        loSinceHi := low
        loSinceHiBar := bar_index
    if not loSw and low < ldnL
        loSw := true
        loSwBar := bar_index
        loSwInWin := inWin
        loSinceLo := low
        loSinceLoBar := bar_index
        hiSinceLo := high
        hiSinceLoBar := bar_index
bool bothSwept = hiSw and loSw
bool twoBear = close < open and close[1] < open[1]
bool twoBull = close > open and close[1] > open[1]
float pivH = ta.pivothigh(high, 2, 2)
float pivL = ta.pivotlow(low, 2, 2)

// ───────────────────────────── S2 eligibility (v6) ─────────────────────────────
// In-window sweep: S2 opens when S1 fails (see the dead block). Pre-open sweep: S1 never arms, so the
// reference is the post-sweep extreme at the first two-candle pullback; S2 opens when price breaks it.
if hiSw
    if s2EligHi
        if high > s2XHi
            s2XHi := high
            s2XHiBar := bar_index
    else if not hiSwInWin
        if na(s2RefHi)
            if twoBear and bar_index - 1 >= hiSwBar
                s2RefHi := hiSinceHi
                s2RefHiBar := hiSinceHiBar
                for k = 0 to math.min(bar_index - s2RefHiBar, 499)
                    if na(s2PullHi) or low[k] < s2PullHi
                        s2PullHi := low[k]
                        s2PullHiBar := bar_index - k
        else
            if low < s2PullHi
                s2PullHi := low
                s2PullHiBar := bar_index
            if s2Swing and not na(pivH) and bar_index - 2 > s2RefHiBar and pivH < s2RefHi
                s2SwingHi := pivH
            bool brokeRef = high > s2RefHi
            bool brokeSw = not na(s2SwingHi) and high > s2SwingHi
            if brokeRef or brokeSw
                s2EligHi := true
                s2EligHiBar := bar_index
                s2A1Hi := s2PullHi         // [IMPL-confirm] pre-open: S2's 1.0 = pullback low before the break
                s2A1HiBar := s2PullHiBar
                s2XHi := high
                s2XHiBar := bar_index
                s2WhyHi := brokeRef ? "break" : "swing"
if loSw
    if s2EligLo
        if low < s2XLo
            s2XLo := low
            s2XLoBar := bar_index
    else if not loSwInWin
        if na(s2RefLo)
            if twoBull and bar_index - 1 >= loSwBar
                s2RefLo := loSinceLo
                s2RefLoBar := loSinceLoBar
                for k = 0 to math.min(bar_index - s2RefLoBar, 499)
                    if na(s2PullLo) or high[k] > s2PullLo
                        s2PullLo := high[k]
                        s2PullLoBar := bar_index - k
        else
            if high > s2PullLo
                s2PullLo := high
                s2PullLoBar := bar_index
            if s2Swing and not na(pivL) and bar_index - 2 > s2RefLoBar and pivL > s2RefLo
                s2SwingLo := pivL
            bool brokeRef = low < s2RefLo
            bool brokeSw = not na(s2SwingLo) and low < s2SwingLo
            if brokeRef or brokeSw
                s2EligLo := true
                s2EligLoBar := bar_index
                s2A1Lo := s2PullLo         // [IMPL-confirm] pre-open: S2's 1.0 = pullback high before the break
                s2A1LoBar := s2PullLoBar
                s2XLo := low
                s2XLoBar := bar_index
                s2WhyLo := brokeRef ? "break" : "swing"

// ───────────────────────────── Fills (§11: count filled entries, not end-of-bar state) ─────────────────────────────
int tradeCount = strategy.opentrades + strategy.closedtrades
int newFills = tradeCount - lastTradeCount
lastTradeCount := tradeCount

if newFills > 0 and checkInv and not na(ordPrice)
    float fillPx = strategy.position_size != 0 ? strategy.position_avg_price : strategy.closedtrades.entry_price(strategy.closedtrades - 1)
    bool okFill = setupDir == 1 ? fillPx <= ordPrice + syminfo.mintick : fillPx >= ordPrice - syminfo.mintick
    if not okFill
        runtime.error(str.format("INVARIANT fill {0} worse than limit {1} at {2}", fillPx, ordPrice, str.format_time(time, "yyyy-MM-dd HH:mm", TZ)))
if newFills > 0
    tradesToday += newFills
    inPos := true
    posScen := setupScen
    posDir := setupDir
    posLevel := ordLevel
    posA1 := a1
    posA0 := a0
    posRiskUsd := ordRiskPts * syminfo.pointvalue * ordQty
    posVa := lockVa
    posLegTrig := initRange
    posBarsToFill := bar_index - trigBar
    posBarsToLock := lockBar - trigBar
    posEntryTime := time
    if showLabels
        label.new(bar_index, posDir == 1 ? low : high,
             scenName(posScen, posDir) + " @" + str.tostring(posLevel) + "\nva " + fmt(posVa, "#.###") + " · " + str.tostring(posBarsToFill) + " bars · " + str.tostring(ordQty) + " ct",
             style = posDir == 1 ? label.style_label_up : label.style_label_down,
             color = color.new(color.blue, 10), textcolor = color.white, size = size.small)
    setupScen := 0
    ordLevel := 0.0

// ───────────────────────────── Closed trades → R log (§16) ─────────────────────────────
if strategy.closedtrades > lastClosed
    for j = lastClosed to strategy.closedtrades - 1
        float pnl = strategy.closedtrades.profit(j)
        float r = posRiskUsd > 0 ? pnl / posRiskUsd : na
        float mfeR = posRiskUsd > 0 ? strategy.closedtrades.max_runup(j) / posRiskUsd : na
        float maeR = posRiskUsd > 0 ? strategy.closedtrades.max_drawdown(j) / posRiskUsd : na
        if not na(r)
            nTrades += 1
            nWins += pnl > 0 ? 1 : 0
            if posLevel == 0.588
                n0588 += 1
                w0588 += pnl > 0 ? 1 : 0
                r0588 += r
            else
                n050 += 1
                w050 += pnl > 0 ? 1 : 0
                r050 += r
            cumR += r
            peakR := math.max(peakR, cumR)
            maxDdR := math.max(maxDdR, peakR - cumR)
            weekR += r
            if useWeekly and not weekLimitHit and weekR <= -weekLimitR
                weekLimitHit := true
                daysOffLeft := daysOff
        log.info("TRADE | entry {0} | {1} | level {2} | va@lock {3} | leg@trigger {4} | leg@lock {5} | bars→lock {10} | bars→fill {6} | R {7} | MFE {8}R | MAE {9}R",
             str.format_time(posEntryTime, "yyyy-MM-dd HH:mm", TZ), scenName(posScen, posDir), posLevel, fmt(posVa, "#.###"),
             fmt(posLegTrig, "#.##"), fmt(math.abs(posA1 - posA0), "#.##"), posBarsToFill, fmt(r, "#.##"), fmt(mfeR, "#.##"), fmt(maeR, "#.##"), posBarsToLock)
        if showLabels
            label.new(bar_index, posDir == 1 ? high : low, (r >= 0 ? "+" : "") + fmt(r, "#.##") + "R",
                 style = posDir == 1 ? label.style_label_down : label.style_label_up,
                 color = r >= 0 ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)
    lastClosed := strategy.closedtrades
    inPos := false
    lastDeathBar := bar_index          // §11: a closed trade retires its setup
    if tradesToday >= maxTrades
        doneDay := true

// ───────────────────────────── In position: fixed bracket, flat at 14:00 (§10) ─────────────────────────────
if inPos and strategy.position_size != 0
    float sP = math.round_to_mintick(fibPrice(posA1, posA0, posDir, stopLevel(posLevel)))
    float tP = math.round_to_mintick(fibPrice(posA1, posA0, posDir, targetLevel(posLevel)))
    strategy.exit("X", "E", stop = sP, limit = tP)
    plotE := strategy.position_avg_price
    plotS := sP
    plotT := tP
    if atFlatten or nyMin >= 840
        strategy.close_all(comment = "14:00", immediately = true)

// ───────────────────────────── Arm a new setup (§5, §6) ─────────────────────────────
// Once both London levels are swept it is S3 — never S1 or S2.
bool riskOff = doneDay or tradesToday >= maxTrades or failsToday >= maxFails or blockedToday or isNews
bool canArm  = setupScen == 0 and not inPos and strategy.position_size == 0 and not riskOff and inWin and prevInWin and canPlace and ldnValid and isWeekday and bar_index - 1 > lastDeathBar
bool justArmed = false

if canArm
    int   cScen = 0
    int   cDir = 0
    int   cSide = 0
    float cA1 = na
    float cA0 = na
    int   cStart = na
    int   cA0Bar = na
    if bothSwept
        if useS3 and not s3Dead and hiSwBar != loSwBar and bar_index - 1 >= math.max(hiSwBar, loSwBar)
            bool lowSecond = loSwBar > hiSwBar
            if lowSecond and twoBull
                cScen := 3
                cDir := -1
                cA1 := hiSinceHi
                cA0 := loSinceLo
                cA0Bar := loSinceLoBar
                cStart := math.min(hiSinceHiBar, loSinceLoBar)
            else if not lowSecond and twoBear
                cScen := 3
                cDir := 1
                cA1 := loSinceLo
                cA0 := hiSinceHi
                cA0Bar := hiSinceHiBar
                cStart := math.min(loSinceLoBar, hiSinceHiBar)
    else if useS1 and hiSw and hiSwInWin and not s1FailHi and twoBear and bar_index - 1 >= hiSwBar
        cScen := 1
        cDir := -1
        cSide := 1
        cA1 := hiSinceHi
        cA0 := loSinceHi
        cA0Bar := loSinceHiBar
        cStart := math.min(hiSinceHiBar, loSinceHiBar)
    else if useS1 and loSw and loSwInWin and not s1FailLo and twoBull and bar_index - 1 >= loSwBar
        cScen := 1
        cDir := 1
        cSide := -1
        cA1 := loSinceLo
        cA0 := hiSinceLo
        cA0Bar := hiSinceLoBar
        cStart := math.min(loSinceLoBar, hiSinceLoBar)
    else if useS2 and s2EligHi and not s2DeadHi and twoBull and bar_index - 1 >= s2EligHiBar
        cScen := 2
        cDir := 1
        cSide := 1
        cA1 := s2A1Hi                  // §6 (corrected): S1's anchor_0 where S1 failed, not the trigger wick
        cA0 := s2XHi                   // running high since then
        cA0Bar := s2XHiBar
        cStart := math.min(s2A1HiBar, s2XHiBar)
    else if useS2 and s2EligLo and not s2DeadLo and twoBear and bar_index - 1 >= s2EligLoBar
        cScen := 2
        cDir := -1
        cSide := -1
        cA1 := s2A1Lo
        cA0 := s2XLo
        cA0Bar := s2XLoBar
        cStart := math.min(s2A1LoBar, s2XLoBar)
    if cScen != 0
        float leg = math.abs(cA1 - cA0)
        if leg == 0 or (useLegFilter and (leg < legMinPts or leg > legMaxPts))
            lastDeathBar := bar_index      // rejected at trigger, not counted as a failure [IMPL]
            if showLabels
                label.new(bar_index, cDir == 1 ? low : high, scenName(cScen, cDir) + " rejected\nleg " + str.tostring(leg, "#.##"),
                     style = cDir == 1 ? label.style_label_up : label.style_label_down,
                     color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny)
        else
            setupScen := cScen
            setupDir := cDir
            setupSide := cSide
            a1 := cA1
            a0 := cA0
            liveA0 := cA0
            liveA0Bar := cA0Bar
            extending := cDir == -1 ? low <= cA0 : high >= cA0
            setupFrozen := false
            setupLocked := false
            lockLevel := 0.0
            lockVa := na
            lockEntry := na
            lockBar := na
            initRange := leg
            trigBar := bar_index
            legStart := cStart
            ordLevel := 0.0
            justArmed := true
            a1AtArm := cA1
            a0AtFreeze := na
            if showLabels
                label.new(bar_index, cDir == 1 ? low : high, scenName(cScen, cDir) + "\nleg " + str.tostring(leg, "#.##"),
                     style = cDir == 1 ? label.style_label_up : label.style_label_down,
                     color = color.new(color.orange, 10), textcolor = color.white, size = size.small)

// ───────────────────────────── Armed: what ends a setup (§11) ─────────────────────────────
bool   dead = false
bool   broke = false
bool   countFail = true
string why = ""

if setupScen != 0 and not inPos and not justArmed
    if setupDir == -1 ? high > a1 : low < a1
        dead := true
        broke := true
        why := "1.0 broken"
    else if setupLocked and ordLevel == 0 and (setupDir == -1 ? high >= lockEntry : low <= lockEntry)
        dead := true
        why := "entry touched, no fill"
    else if setupScen != 3 and bothSwept
        dead := true
        countFail := false
        why := "both swept → S3"     // [IMPL] an armed S1/S2 gives way to S3
    else if expiryBars > 0 and bar_index - trigBar >= expiryBars
        dead := true
        why := "expired"
    else if not canPlace
        dead := true
        countFail := false
        why := "14:00"
    if not dead
        float prevLive = liveA0
        extending := setupDir == -1 ? low < prevLive : high > prevLive
        liveA0 := setupDir == -1 ? math.min(prevLive, low) : math.max(prevLive, high)
        if extending
            liveA0Bar := bar_index
        if extending and setupFrozen
            // New extreme: the retracement was false. Unlock and keep dragging the fib.
            setupFrozen := false
            setupLocked := false
            lockLevel := 0.0
            lockVa := na
            lockEntry := na
            lockBar := na
        if not setupFrozen
            a0 := liveA0
        if legGrowMax > 0 and math.abs(a1 - liveA0) > legGrowMax * initRange
            dead := true
            why := "leg grew"

// ───────────────────────────── Armed: freeze, watch the value area, place the limit (§8, §9) ─────────────────────────────
if setupScen != 0 and not inPos and not dead
    // STEP 1 — freeze the anchors on the first bar that does not extend the leg.
    if not setupFrozen and not extending
        setupFrozen := true
        a0AtFreeze := a0
    if checkInv
        if a1 != a1AtArm
            runtime.error(str.format("INVARIANT a1 moved {0} -> {1} at {2}", a1AtArm, a1, str.format_time(time, "yyyy-MM-dd HH:mm", TZ)))
        if (setupDir == -1 ? a1 - a0 : a0 - a1) <= 0
            runtime.error(str.format("INVARIANT leg not positive a1 {0} a0 {1} at {2}", a1, a0, str.format_time(time, "yyyy-MM-dd HH:mm", TZ)))
        if setupFrozen and a0 != a0AtFreeze
            runtime.error(str.format("INVARIANT a0 moved while frozen {0} -> {1} at {2}", a0AtFreeze, a0, str.format_time(time, "yyyy-MM-dd HH:mm", TZ)))
    // STEP 2 — after the freeze, re-check va_ratio every bar (retracement bars included) until it enters the band.
    if setupFrozen and not setupLocked
        float va = na
        if setupScen != 3
            int   pFrom = legStart
            int   pTo = bar_index
            float pLo = math.min(a1, a0)
            float pHi = math.max(a1, a0)
            if vpRange == "London"
                pFrom := dayStartBar
                pTo := ldnEndBar
                pLo := ldnL
                pHi := ldnH
            [vah, val] = valueArea(pFrom, pTo, pLo, pHi)
            float rng = math.abs(a1 - a0)
            if not na(vah) and rng > 0
                va := setupDir == -1 ? (vah - a0) / rng : (a0 - val) / rng
        float lvl = chooseLevel(setupScen, va)
        if lvl > 0
            setupLocked := true
            lockLevel := lvl
            lockVa := va
            lockBar := bar_index
            lockEntry := math.round_to_mintick(fibPrice(a1, a0, setupDir, lvl))
            if showLabels
                label.new(bar_index, setupDir == 1 ? low : high, "lock @" + str.tostring(lvl) + "\nva " + fmt(va, "#.###"),
                     style = setupDir == 1 ? label.style_label_up : label.style_label_down,
                     color = color.new(color.purple, 10), textcolor = color.white, size = size.tiny)
    ordLevel := 0.0
    if setupLocked
        float eP = lockEntry
        float sP = math.round_to_mintick(fibPrice(a1, a0, setupDir, stopLevel(lockLevel)))
        float tP = math.round_to_mintick(fibPrice(a1, a0, setupDir, targetLevel(lockLevel)))
        if setupDir == -1 ? close >= eP : close <= eP
            dead := true               // closed through the entry before any order could work [IMPL]
            why := "entry touched, no fill"
        else
            float riskEff = riskUsd * (useDdCut and peakR - cumR >= ddLimitR ? ddRiskMult : 1.0)
            float rp = math.abs(sP - eP)
            int qty = rp > 0 ? math.min(int(math.floor(riskEff / (rp * syminfo.pointvalue))), maxContracts) : 0
            if qty >= 1                // §12: never round up, never force 1 contract
                if checkInv and not (setupDir == -1 ? tP < eP and eP < sP : sP < eP and eP < tP)
                    runtime.error(str.format("INVARIANT bracket on wrong side stop {0} entry {1} target {2} at {3}", sP, eP, tP, str.format_time(time, "yyyy-MM-dd HH:mm", TZ)))
                strategy.entry("E", setupDir == 1 ? strategy.long : strategy.short, qty = qty, limit = eP,
                     comment = scenName(setupScen, setupDir) + " @" + str.tostring(lockLevel))
                strategy.exit("X", "E", stop = sP, limit = tP)
                ordLevel := lockLevel
                ordPrice := eP
                ordQty := qty
                ordRiskPts := rp
                plotE := eP
                plotS := sP
                plotT := tP
    if ordLevel == 0
        strategy.cancel("E")
        strategy.cancel("X")

if dead
    strategy.cancel("E")
    strategy.cancel("X")
    if countFail
        failsToday += 1
    if broke
        if setupScen == 1
            if setupSide == 1
                s1FailHi := true
                s2EligHi := true       // S1 failed by breaking its 1.0: S2 opens on this side
                s2EligHiBar := bar_index
                s2A1Hi := a0               // S2 inherits S1's anchor_0 as its anchor_1
                s2A1HiBar := liveA0Bar
                s2XHi := hiSinceHi
                s2XHiBar := hiSinceHiBar
                s2WhyHi := "S1 failed"
            else
                s1FailLo := true
                s2EligLo := true
                s2EligLoBar := bar_index
                s2A1Lo := a0
                s2A1LoBar := liveA0Bar
                s2XLo := loSinceLo
                s2XLoBar := loSinceLoBar
                s2WhyLo := "S1 failed"
        else if setupScen == 2
            if setupSide == 1
                s2DeadHi := true
            else
                s2DeadLo := true
        else
            s3Dead := true
    if showLabels
        label.new(bar_index, setupDir == 1 ? low : high, "✗ " + why,
             style = setupDir == 1 ? label.style_label_up : label.style_label_down,
             color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)
    lastDeathBar := bar_index
    setupScen := 0
    ordLevel := 0.0

// ───────────────────────────── Plots ─────────────────────────────
plot(showLdn ? ldnH : na, "London high", color.new(color.gray, 20), 1, plot.style_linebr)
plot(showLdn ? ldnL : na, "London low", color.new(color.gray, 20), 1, plot.style_linebr)
plot(showLevels ? plotE : na, "Entry", color.new(color.blue, 0), 2, plot.style_linebr)
plot(showLevels ? plotS : na, "Stop", color.new(color.red, 0), 2, plot.style_linebr)
plot(showLevels ? plotT : na, "Target", color.new(color.green, 0), 2, plot.style_linebr)
plot(showFib ? (setupScen != 0 ? a1 : inPos ? posA1 : na) : na, "Fib 1.0", color.new(color.orange, 0), 1, plot.style_linebr)
plot(showFib ? (setupScen != 0 ? a0 : inPos ? posA0 : na) : na, "Fib 0", color.new(color.purple, 0), 1, plot.style_linebr)
bgcolor(inWin ? color.new(color.blue, 94) : na, title = "Trading window")

// ───────────────────────────── Stats (§17) ─────────────────────────────
// Breakeven win rate = 1 / (1 + reward/risk): 0.5 entries 1.15R → 46.5%, 0.588 entries 1.00R → 50%.
if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 11, bgcolor = color.new(color.black, 20), border_width = 1)
    float wr   = nTrades > 0 ? 100.0 * nWins / nTrades : na
    float be   = nTrades > 0 ? (n050 * 46.5 + n0588 * 50.0) / nTrades : na
    float wr05 = n050 > 0 ? 100.0 * w050 / n050 : na
    float wr58 = n0588 > 0 ? 100.0 * w0588 / n0588 : na
    table.cell(t, 0, 0, "Trades", text_color = color.white)
    table.cell(t, 1, 0, str.tostring(nTrades) + (nTrades < 50 ? "  (<50)" : ""), text_color = nTrades < 50 ? color.orange : color.white)
    table.cell(t, 0, 1, "Win rate / breakeven", text_color = color.white)
    table.cell(t, 1, 1, fmt(wr, "#.#") + "% / " + fmt(be, "#.#") + "%", text_color = na(wr) ? color.white : wr > be ? color.lime : color.red)
    table.cell(t, 0, 2, "0.5 entries (1.15R, BE 46.5%)", text_color = color.white)
    table.cell(t, 1, 2, str.tostring(n050) + " · " + fmt(wr05, "#.#") + "% · " + fmt(r050, "#.##") + "R", text_color = color.white)
    table.cell(t, 0, 3, "0.588 entries (1.00R, BE 50%)", text_color = color.white)
    table.cell(t, 1, 3, str.tostring(n0588) + " · " + fmt(wr58, "#.#") + "% · " + fmt(r0588, "#.##") + "R", text_color = color.white)
    table.cell(t, 0, 4, "Total R", text_color = color.white)
    table.cell(t, 1, 4, fmt(cumR, "#.##"), text_color = cumR >= 0 ? color.lime : color.red)
    table.cell(t, 0, 5, "Avg R", text_color = color.white)
    table.cell(t, 1, 5, nTrades > 0 ? fmt(cumR / nTrades, "#.###") : "n/a", text_color = color.white)
    table.cell(t, 0, 6, "Max DD (R)", text_color = color.white)
    table.cell(t, 1, 6, fmt(maxDdR, "#.##"), text_color = maxDdR < 6 ? color.lime : color.red)
    table.cell(t, 0, 7, "Today: trades / fails", text_color = color.white)
    table.cell(t, 1, 7, str.tostring(tradesToday) + " / " + str.tostring(failsToday), text_color = color.white)
    table.cell(t, 0, 8, "Risk multiplier", text_color = color.white)
    table.cell(t, 1, 8, useDdCut and peakR - cumR >= ddLimitR ? str.tostring(ddRiskMult) : "1", text_color = color.white)
    table.cell(t, 0, 9, "Days off left", text_color = color.white)
    table.cell(t, 1, 9, str.tostring(daysOffLeft) + (blockedToday or isNews ? "  (off today)" : ""), text_color = color.white)
    table.cell(t, 0, 10, "Active setup", text_color = color.white)
    table.cell(t, 1, 10, setupScen == 0 ? "none" : scenName(setupScen, setupDir) + (setupLocked ? " · locked @" + str.tostring(lockLevel) : setupFrozen ? " · frozen" : " · forming"), text_color = color.white)
