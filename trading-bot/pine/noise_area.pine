//@version=6
// Noise-Area Intraday Momentum (Zarattini, Aziz & Barbon 2024, "Beat the Market") for NQ / MNQ.
// Chart: MNQ1! or NQ1!, 30 minutes. Turn ON "Adjust for contract changes" (back-adjust) so roll gaps don't fake a gap.
//
// Rules (tested in trading-bot/research, 2020–2026, 976 trades, 57.7 % wins, 7/7 years positive):
//   sigma(slot)  = average of |close / open(09:30) − 1| at that half-hour, over the previous N full sessions
//   Upper band   = max(open 09:30, prior 16:00 close) × (1 + sigma)
//   Lower band   = min(open 09:30, prior 16:00 close) × (1 − sigma)
//   At each half-hour close 10:00 … 15:30: close > Upper → long, close < Lower → short (reverse if needed);
//   long exits when close < Lower, short exits when close > Upper. Everything flat at 16:00.
strategy("Noise-Area Momentum [NQ]", shorttitle = "NoiseArea", overlay = true,
     process_orders_on_close = true, pyramiding = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.75,
     slippage = 1, initial_capital = 50000)

lookback  = input.int(14, "Noise lookback (sessions)", minval = 5, maxval = 60)
every     = input.int(30, "Decide every (minutes)", options = [30, 60])
useVwap   = input.bool(false, "Also exit on VWAP cross (variant, weaker out-of-sample)")
longOnly  = input.bool(false, "Long only (variant, weaker out-of-sample)")
qty       = input.int(1, "Contracts", minval = 1)
showBands = input.bool(true, "Show bands")

if timeframe.period != "30"
    runtime.error("Noise-Area: use a 30-minute chart.")

// ---------- New York clock
tz   = "America/New_York"
tod  = hour(time, tz) * 60 + minute(time, tz)          // bar open, minutes after midnight NY
isRTH = tod >= 570 and tod < 960
slot = isRTH ? int(math.floor((tod - 570) / 30.0)) : -1   // 0 = 09:30 bar … 12 = 15:30 bar

// ---------- state
var matrix<float> hist  = matrix.new<float>(0, 12, na)  // one row per full session: move at slots 0..11
var array<float>  today = array.new<float>(12, na)
var float open930 = na
var float prevClose = na
var float lastRthClose = na
var float cumPV = 0.0
var float cumV  = 0.0

if slot == 0
    open930   := open
    prevClose := lastRthClose
    array.fill(today, na)
    cumPV := 0.0
    cumV  := 0.0

if isRTH
    cumPV += hlc3 * volume
    cumV  += volume
vwapRth = cumV > 0 ? cumPV / cumV : close

// ---------- bands for this half-hour
float sig = na
if slot >= 0 and slot <= 11 and matrix.rows(hist) >= lookback
    int n = matrix.rows(hist)
    float s = 0.0
    for r = n - lookback to n - 1
        s += matrix.get(hist, r, slot)
    sig := s / lookback

float ub = na
float lb = na
if not na(sig) and not na(open930) and not na(prevClose)
    ub := math.max(open930, prevClose) * (1 + sig)
    lb := math.min(open930, prevClose) * (1 - sig)

if slot >= 0 and slot <= 11 and not na(open930)
    array.set(today, slot, math.abs(close / open930 - 1))

// ---------- decisions (on the close of the bar that ends at the half-hour mark)
isMark = slot >= 0 and slot <= 11 and ((slot + 1) * 30) % every == 0
pos = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0

if isMark and not na(ub)
    int want = pos
    if pos == 1 and close < (useVwap ? math.max(ub, vwapRth) : lb)
        want := 0
    if pos == -1 and close > (useVwap ? math.min(lb, vwapRth) : ub)
        want := 0
    if close > ub
        want := 1
    else if close < lb and not longOnly
        want := -1
    if want != pos
        if want == 1
            strategy.entry("Long", strategy.long, qty = qty, comment = "NA long", alert_message = "NA LONG")
        else if want == -1
            strategy.entry("Short", strategy.short, qty = qty, comment = "NA short", alert_message = "NA SHORT")
        else
            strategy.close_all(comment = "NA exit", alert_message = "NA FLAT")

// ---------- end of the regular session: flat, remember the close, store today's noise row
lastBar = slot == 12 or (isRTH and session.islastbar_regular)
if lastBar
    strategy.close_all(comment = "16:00", alert_message = "NA FLAT")
    lastRthClose := close
    bool full = true
    for k = 0 to 11
        if na(array.get(today, k))
            full := false
    if full
        matrix.add_row(hist, matrix.rows(hist), array.copy(today))
        if matrix.rows(hist) > 60
            matrix.remove_row(hist, 0)

if not isRTH and strategy.position_size != 0
    strategy.close_all(comment = "outside RTH", alert_message = "NA FLAT")

// ---------- visuals
plot(showBands and isRTH ? ub : na, "Upper band", color.new(color.teal, 0), 2, plot.style_linebr)
plot(showBands and isRTH ? lb : na, "Lower band", color.new(color.red, 0), 2, plot.style_linebr)
plot(showBands and isRTH and useVwap ? vwapRth : na, "VWAP (RTH)", color.new(color.orange, 30), 1, plot.style_linebr)
bgcolor(isRTH and matrix.rows(hist) < lookback ? color.new(color.gray, 90) : na, title = "Warming up")

var table t = table.new(position.top_right, 2, 5, border_width = 1)
if barstate.islast
    int closed = strategy.closedtrades
    table.cell(t, 0, 0, "Noise-Area", text_color = color.white, bgcolor = color.new(color.navy, 0))
    table.cell(t, 1, 0, str.tostring(lookback) + "d / " + str.tostring(every) + "m", text_color = color.white, bgcolor = color.new(color.navy, 0))
    table.cell(t, 0, 1, "Trades")
    table.cell(t, 1, 1, str.tostring(closed))
    table.cell(t, 0, 2, "Win %")
    table.cell(t, 1, 2, closed > 0 ? str.tostring(100.0 * strategy.wintrades / closed, "#.0") : "-")
    table.cell(t, 0, 3, "Net P&L")
    table.cell(t, 1, 3, str.tostring(strategy.netprofit, "#,###"))
    table.cell(t, 0, 4, "Sessions stored")
    table.cell(t, 1, 4, str.tostring(matrix.rows(hist)))
