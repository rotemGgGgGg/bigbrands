//@version=6
// PROP ORB — MNQ 5m or 15m. 15-minute opening range breakout built for a Lucid 50K eval ($2,000 EOD trailing drawdown,
// $3,000 target, flat before 16:45 ET). Mirrors backtest/orb_prop.py.
//
//  • Opening range 09:30–09:45 NY. From 09:45, stop orders one tick beyond both sides (one cancels the other).
//  • Stop = SL × range, target = TP × range (default 0.75 / 1.5 → 1:2). Optional cap on the stop in points.
//  • One trade per day. No new entries after 11:30. Everything flat at 15:55 — nothing is held overnight.
//  • Size by dollars (risk ÷ stop). The day is skipped if one contract risks more than the max.
//  • Prop guards: skip a trade whose full loss would breach the trailing drawdown; stop trading once the target is hit.
strategy("Prop ORB — MNQ 5m", shorttitle = "Prop ORB", overlay = true,
     initial_capital = 50000, pyramiding = 0,
     margin_long = 1, margin_short = 1,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5,
     process_orders_on_close = false, calc_on_every_tick = false, max_labels_count = 500)

const string TZ = "America/New_York"

// ───────────────────────────── Inputs ─────────────────────────────
grpT = "Times (New York)"
orStart   = input.int(570, "Range start (min from midnight, 570 = 09:30)", group = grpT)
orEnd     = input.int(585, "Range end (585 = 09:45)", group = grpT)
lastEntry = input.int(690, "Last new entry (690 = 11:30)", group = grpT)
flatAt    = input.int(955, "Flat at (955 = 15:55)", group = grpT)

grpR = "Risk"
slMult  = input.float(0.75, "Stop = × range", step = 0.05, group = grpR)
tpMult  = input.float(1.5, "Target = × range", step = 0.05, group = grpR)
capPts  = input.float(0.0, "Stop cap in points (0 = off)", step = 5, group = grpR)
capRR   = input.float(2.0, "Target when capped = × stop", step = 0.25, group = grpR)
riskUsd = input.float(250, "Risk per trade $", step = 25, group = grpR)
maxRisk = input.float(350, "Skip the day if 1 contract risks more than $", step = 25, group = grpR)

grpP = "Prop account"
ddLimit   = input.float(2000, "Trailing drawdown $ (end of day)", step = 100, group = grpP)
target    = input.float(3000, "Profit target $", step = 100, group = grpP)
ddGuard   = input.bool(true, "Skip a trade whose full loss would breach the drawdown", group = grpP)
stopAtTgt = input.bool(true, "Stop trading once the target is reached", group = grpP)

if timeframe.period != "5" and timeframe.period != "15"
    runtime.error("Prop ORB runs on the 5- or 15-minute chart.")
int barMin = int(timeframe.in_seconds() / 60)

// ───────────────────────────── Time ─────────────────────────────
int  nyMin  = hour(time, TZ) * 60 + minute(time, TZ)       // bar OPEN time
int  nyDate = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
bool newDay = nyDate != nyDate[1]
float pv = syminfo.pointvalue

// ───────────────────────────── State ─────────────────────────────
var float orH = na
var float orL = na
var bool  tradedToday = false
var int   qtyToday = 0
var float stopPts = na
var float tgtPts = na
var float peakEod = 0.0                 // highest end-of-day closed profit
var bool  passed = false
var bool  failed = false
var int   entriesSeen = 0

float closedPnl = strategy.netprofit
float openPnl = strategy.openprofit

// ───────────────────────────── New day: end-of-day drawdown bookkeeping ─────────────────────────────
if newDay
    float eod = closedPnl[1] + openPnl[1]
    peakEod := math.max(peakEod, eod)
    if eod <= peakEod - ddLimit
        failed := true
    orH := na
    orL := na
    tradedToday := false
    qtyToday := 0
    strategy.cancel_all()

if not passed and closedPnl >= target
    passed := true

// ───────────────────────────── Opening range ─────────────────────────────
if nyMin >= orStart and nyMin < orEnd
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low : math.min(orL, low)

// a fill happened → one trade per day
if strategy.opentrades + strategy.closedtrades > entriesSeen
    tradedToday := true
entriesSeen := strategy.opentrades + strategy.closedtrades

// ───────────────────────────── Orders ─────────────────────────────
bool inEntryWindow = nyMin + barMin >= orEnd and nyMin + barMin <= lastEntry     // decided at this bar's close, works next bar
bool blocked = (stopAtTgt and passed) or failed
if not na(orH) and nyMin + barMin >= orEnd and na(stopPts)
    float rng = orH - orL
    stopPts := slMult * rng
    tgtPts := tpMult * rng
    if capPts > 0 and stopPts > capPts
        stopPts := capPts
        tgtPts := capRR * capPts
    float perContract = stopPts * pv
    int q = int(math.floor(riskUsd / perContract))
    qtyToday := q >= 1 ? q : (perContract <= maxRisk ? 1 : 0)
    // prop guard: the full loss must stay above the trailing drawdown floor
    float room = closedPnl - (peakEod - ddLimit)
    if ddGuard and qtyToday * perContract >= room
        qtyToday := 0
if newDay
    stopPts := na
    tgtPts := na

if strategy.position_size == 0 and not tradedToday and not blocked and inEntryWindow and qtyToday > 0 and not na(orH)
    float buyAt = orH + syminfo.mintick
    float sellAt = orL - syminfo.mintick
    strategy.entry("L", strategy.long, qty = qtyToday, stop = buyAt, oca_name = "orb", oca_type = strategy.oca.cancel, comment = "ORB L")
    strategy.entry("S", strategy.short, qty = qtyToday, stop = sellAt, oca_name = "orb", oca_type = strategy.oca.cancel, comment = "ORB S")
else if strategy.position_size == 0
    strategy.cancel("L")
    strategy.cancel("S")

// bracket relative to the actual fill
int lossTicks = na(stopPts) ? 0 : int(math.round(stopPts / syminfo.mintick))
int profTicks = na(tgtPts) ? 0 : int(math.round(tgtPts / syminfo.mintick))
if lossTicks > 0
    strategy.exit("XL", "L", loss = lossTicks, profit = profTicks)
    strategy.exit("XS", "S", loss = lossTicks, profit = profTicks)

// flat before the close — nothing overnight
if strategy.position_size != 0 and nyMin + barMin >= flatAt
    strategy.close_all(comment = "15:55 flat", immediately = true)

// ───────────────────────────── Plots ─────────────────────────────
bool showOr = nyMin >= orStart and nyMin < flatAt and not na(orH)
plot(showOr ? orH : na, "Range high", color.new(color.teal, 0), 1, plot.style_linebr)
plot(showOr ? orL : na, "Range low", color.new(color.maroon, 0), 1, plot.style_linebr)
bgcolor(nyMin >= orStart and nyMin < orEnd ? color.new(color.gray, 90) : na, title = "Opening range")

// ───────────────────────────── Stats ─────────────────────────────
var float maxDd = 0.0
var float peakEq = 0.0
float eqNow = closedPnl + openPnl
peakEq := math.max(peakEq, eqNow)
maxDd := math.min(maxDd, eqNow - peakEq)

if barstate.islast
    var table tb = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 20), border_width = 1)
    int n = strategy.closedtrades
    table.cell(tb, 0, 0, "Trades", text_color = color.white)
    table.cell(tb, 1, 0, str.tostring(n), text_color = color.white)
    table.cell(tb, 0, 1, "Win %", text_color = color.white)
    table.cell(tb, 1, 1, n > 0 ? str.tostring(100.0 * strategy.wintrades / n, "#.#") : "-", text_color = color.white)
    table.cell(tb, 0, 2, "Net $", text_color = color.white)
    table.cell(tb, 1, 2, str.tostring(closedPnl, "#"), text_color = closedPnl >= 0 ? color.lime : color.red)
    table.cell(tb, 0, 3, "Max DD $", text_color = color.white)
    table.cell(tb, 1, 3, str.tostring(maxDd, "#"), text_color = color.white)
    table.cell(tb, 0, 4, "Room to DD $", text_color = color.white)
    table.cell(tb, 1, 4, str.tostring(closedPnl - (peakEod - ddLimit), "#"), text_color = color.white)
    table.cell(tb, 0, 5, "Eval", text_color = color.white)
    table.cell(tb, 1, 5, failed ? "FAILED" : passed ? "PASSED" : "running", text_color = failed ? color.red : passed ? color.lime : color.white)
    table.cell(tb, 0, 6, "Today size", text_color = color.white)
    table.cell(tb, 1, 6, str.tostring(qtyToday) + " ct", text_color = color.white)
