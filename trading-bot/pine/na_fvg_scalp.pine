//@version=6
// NA-FVG Scalp — momentum day + Fair Value Gap retrace, tiny target / wide stop (high win rate with a real edge).
// Chart: MNQ1! or NQ1!, 1 minute. Research: trading-bot/research/winrate (2020–2026, 812 trades,
// 88 % wins, +$9/trade per MNQ after $2.50 costs, positive 2020–23 AND 2024–26, max 2–3 losses in a row).
//
// 1. Noise band (Zarattini et al.): sigma(t) = mean |close/open09:30 − 1| at that half-hour over the last 14 sessions.
//    Upper = max(open, prior 16:00 close)·(1+sigma), Lower = min(…)·(1−sigma).
// 2. The first half-hour close (10:00 … 15:30) outside the band sets today's direction.
// 3. After that, the first 1-minute Fair Value Gap in that direction (long: high[2] < low) marks the level;
//    a limit order waits at the gap's edge (long: the gap top = that bar's low) for up to 60 minutes.
// 4. Target = 0.10 × typical daily move, stop = 1.5 × typical daily move (92 % wins, both periods; research/winrate/hiwin.py)
//    (typical daily move = 14-day mean |close/open − 1| × price). Flat at 15:55. One trade a day.
// margin 1%: Pine v6 defaults to 100%, which silently rejects every MNQ order (1 contract ≈ $62K > $50K capital).
strategy("NA-FVG Scalp [NQ]", shorttitle = "NA-FVG", overlay = true, pyramiding = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1, initial_capital = 50000,
     margin_long = 1, margin_short = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.75, slippage = 1)

lookback = input.int(14, "Noise lookback (sessions)", minval = 5, maxval = 60)
tpMult   = input.float(0.10, "Target × daily move", step = 0.025)
slMult   = input.float(1.5, "Stop × daily move", step = 0.25)
fvgWin   = input.int(60, "FVG window after the break (minutes)", minval = 10, maxval = 240)
qty      = input.int(1, "Contracts", minval = 1)
showBand = input.bool(true, "Show noise band")

if timeframe.period != "1"
    runtime.error("NA-FVG: use a 1-minute chart.")

tz  = "America/New_York"
tod = hour(time, tz) * 60 + minute(time, tz)
isRTH = tod >= 570 and tod < 960
k = isRTH ? tod - 570 : -1                                // minute index of the bar (0 = 09:30)

// ---------------- noise band + daily move, computed on 30-minute bars (long history, no warm-up on the 1m chart)
f30() =>
    string z = "America/New_York"
    int t30 = hour(time, z) * 60 + minute(time, z)
    int sl = t30 >= 570 and t30 < 960 ? int((t30 - 570) / 30) : -1      // 0 = 09:30 bar … 12 = 15:30 bar
    var matrix<float> hist = matrix.new<float>(0, 12, na)
    var array<float> dayMove = array.new<float>()
    var array<float> today = array.new<float>(12, na)
    var float o930 = na
    var float pClose = na
    var float lClose = na
    if sl == 0
        o930 := open
        pClose := lClose
        array.fill(today, na)
    float u = na
    float d = na
    int n = matrix.rows(hist)
    int use = math.min(n, lookback)                         // works with short chart history (min 3 sessions)
    if sl >= 0 and sl <= 11 and use >= 3 and not na(pClose)
        float s = 0.0
        for r = n - use to n - 1
            s += matrix.get(hist, r, sl)
        u := math.max(o930, pClose) * (1 + s / use)
        d := math.min(o930, pClose) * (1 - s / use)
    if sl >= 0 and sl <= 11 and not na(o930)
        array.set(today, sl, math.abs(close / o930 - 1))
    if sl == 12
        lClose := close
        if not na(o930)
            array.push(dayMove, math.abs(close / o930 - 1))
            if array.size(dayMove) > 60
                array.shift(dayMove)
        bool full = true
        for j = 0 to 11
            if na(array.get(today, j))
                full := false
        if full
            matrix.add_row(hist, matrix.rows(hist), array.copy(today))
            if matrix.rows(hist) > 60
                matrix.remove_row(hist, 0)
    float ds = na
    int m = math.min(array.size(dayMove), 14)
    if m >= 3
        float t = 0.0
        for i = array.size(dayMove) - m to array.size(dayMove) - 1
            t += array.get(dayMove, i)
        ds := t / m
    [u, d, close, sl, ds, n]

fPrev() =>
    [u, d, c30, sl, ds, n] = f30()
    [u[1], d[1], c30[1], sl[1], ds[1], n]                    // the last COMPLETED 30-minute bar → no look-ahead

[ub, lb, markClose, markSlot, dSig, nDays] = request.security(syminfo.tickerid, "30", fPrev(), lookahead = barmerge.lookahead_on)
bool newHalfHour = ta.change(time("30")) != 0

var int dir = 0
var int breakK = na
var float gapLvl = na
var int gapK = na
var bool traded = false
if k == 0
    dir := 0
    breakK := na
    gapLvl := na
    gapK := na
    traded := false

// 1) direction from the first half-hour close outside the band (marks 10:00 … 15:30)
if newHalfHour and isRTH and dir == 0 and markSlot >= 0 and markSlot <= 11 and not na(ub)
    if markClose > ub
        dir := 1
        breakK := k
    else if markClose < lb
        dir := -1
        breakK := k

// 2) first FVG in that direction (bars breakK … breakK+window)
bool inWin = dir != 0 and not na(breakK) and k >= breakK and k < breakK + fvgWin and k < 385
if inWin and na(gapLvl) and not traded and k >= breakK + 2
    if dir == 1 and high[2] < low
        gapLvl := low
        gapK := k
    else if dir == -1 and low[2] > high
        gapLvl := high
        gapK := k

// 3) limit order at the gap edge while the window is open
bool canOrder = inWin and not na(gapLvl) and k > gapK and not traded and strategy.position_size == 0 and not na(dSig)
if canOrder
    float sc = dSig * gapLvl
    if dir == 1
        strategy.entry("L", strategy.long, qty = qty, limit = gapLvl, comment = "FVG long")
        strategy.exit("Lx", "L", limit = gapLvl + tpMult * sc, stop = gapLvl - slMult * sc)
    else
        strategy.entry("S", strategy.short, qty = qty, limit = gapLvl, comment = "FVG short")
        strategy.exit("Sx", "S", limit = gapLvl - tpMult * sc, stop = gapLvl + slMult * sc)
if not inWin and strategy.position_size == 0
    strategy.cancel("L")
    strategy.cancel("S")
if strategy.position_size != 0
    traded := true

// 4) flat at 15:55, session bookkeeping at 16:00
if k == 384 or (isRTH and session.islastbar_regular)
    strategy.close_all(comment = "15:55")
    strategy.cancel_all()

// ---------------- visuals
plot(showBand and isRTH ? ub : na, "Upper band (last mark)", color.teal, 1, plot.style_stepline)
plot(showBand and isRTH ? lb : na, "Lower band (last mark)", color.red, 1, plot.style_stepline)
plot(not na(gapLvl) and inWin ? gapLvl : na, "FVG level", color.orange, 1, plot.style_linebr)
plotshape(dir == 1 and dir[1] != 1, "Long set", shape.triangleup, location.top, color.lime, size = size.tiny)
plotshape(dir == -1 and dir[1] != -1, "Short set", shape.triangledown, location.top, color.red, size = size.tiny)
plotshape(not na(gapLvl) and na(gapLvl[1]), "FVG found", shape.diamond, location.bottom, color.orange, size = size.tiny)
bgcolor(isRTH and (na(dSig) or na(ub)) ? color.new(color.gray, 92) : na, title = "Warming up")

// ---------------- status panel (to see why there is or isn't a trade)
var table st = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    table.cell(st, 0, 0, "Sessions stored", text_color = color.white)
    table.cell(st, 1, 0, str.tostring(nDays) + (nDays < 3 ? " (need 3)" : ""), text_color = color.white)
    table.cell(st, 0, 1, "Daily move", text_color = color.white)
    table.cell(st, 1, 1, na(dSig) ? "—" : str.tostring(dSig * close, "#.0") + " pt", text_color = color.white)
    table.cell(st, 0, 2, "Band now", text_color = color.white)
    table.cell(st, 1, 2, na(ub) ? "—" : str.tostring(lb, "#.00") + " / " + str.tostring(ub, "#.00"), text_color = color.white)
    table.cell(st, 0, 3, "Today's direction", text_color = color.white)
    table.cell(st, 1, 3, dir == 1 ? "LONG" : dir == -1 ? "SHORT" : "none yet", text_color = dir == 1 ? color.lime : dir == -1 ? color.red : color.gray)
    table.cell(st, 0, 4, "FVG level", text_color = color.white)
    table.cell(st, 1, 4, na(gapLvl) ? "—" : str.tostring(gapLvl, "#.00"), text_color = color.orange)
    table.cell(st, 0, 5, "Traded today", text_color = color.white)
    table.cell(st, 1, 5, traded ? "yes" : "no", text_color = color.white)
    table.cell(st, 0, 6, "Closed trades", text_color = color.white)
    table.cell(st, 1, 6, str.tostring(strategy.closedtrades), text_color = color.white)
