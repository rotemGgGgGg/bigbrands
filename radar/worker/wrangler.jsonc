{
  "name": "radar",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "radar", "database_id": "b4822c07-d76b-4b05-8b0f-de02678339d9" }
  ],
  "kv_namespaces": [
    { "binding": "STATE", "id": "5d2130cfafd544ed843730ae558438c5" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CLUSTERS", "class_name": "ClusterState" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ClusterState"] }
  ],
  // Shut down. The scan ran every minute and the webhook pushed every block;
  // both are off, so the worker costs nothing until it is asked to work again.
  "triggers": { "crons": [] },
  "vars": {
    "POLL_SLICES": "2",
    "MIN_SOL_BUY": "0.05",
    "RE_ALERT_MINUTES": "60",
    "MIN_FEED_WALLETS": "2",
    "MIN_FEED_SCORE": "80",
    "CLUSTER_WINDOW_MINUTES": "10",

    // Legends 101. Every bar is deliberately extreme: a rare channel is the
    // whole point, and one that fires daily is the feed channel renamed.
    "RADAR_ENABLED": "false",
    "LEGENDS_ENABLED": "false",
    "LEGENDS_MIN_OPERATORS": "8",
    "LEGENDS_MIN_SOL": "25",
    "LEGENDS_SPRAYER_BUYS": "200",
    "LEGENDS_MIN_LIQUIDITY": "5000",
    "LEGENDS_OVERSIZED_MULTIPLE": "3",

    // Legends is meant not to be missed, so it keeps knocking. The gap is
    // above Telegram's roughly one-a-second ceiling for a single chat.
    "LEGENDS_BLAST_COUNT": "12",
    "LEGENDS_BLAST_GAP_MS": "1200"
  }
}
