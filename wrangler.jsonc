{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bigbrands",
  "compatibility_date": "2026-07-21",
  "observability": {
    "enabled": true
  },
  "main": "src/worker.js",
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*", "/admin.*", "/api/*", "/js/admin.js"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
